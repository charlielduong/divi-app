# Copy to supabase/.env for local Supabase Auth configuration.
# Register this callback in Google Cloud for simulator/browser testing:
# http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_URL=http://127.0.0.1:54321
SUPABASE_AUTH_EXTERNAL_GOOGLE_REDIRECT_URI=http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=<GOOGLE_WEB_CLIENT_ID>
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=<GOOGLE_CLIENT_SECRET>
