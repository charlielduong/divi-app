# Copy to supabase/.env for local Supabase Auth configuration.
# Register this callback in Google Cloud:
# https://<ngrok-host>/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_URL=https://<ngrok-host>
SUPABASE_AUTH_EXTERNAL_GOOGLE_REDIRECT_URI=https://<ngrok-host>/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=<GOOGLE_WEB_CLIENT_ID>
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=<GOOGLE_CLIENT_SECRET>
