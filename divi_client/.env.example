# Hosted Supabase project for device, TestFlight, and production development.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Local simulator alternative: copy the publishable key printed by `supabase start`.
# EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<COPY_LOCAL_PUBLISHABLE_KEY_FROM_SUPABASE_START>

# TestFlight/EAS production values should be configured in EAS, not committed here.
#
# Never put a Supabase secret/service-role key or AWS credential in this file or
# in any EXPO_PUBLIC_ variable. The receipt-analysis Edge Functions keep those
# credentials server-side.
