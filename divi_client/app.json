{
  "expo": {
    "name": "Divi",
    "slug": "divi",
    "scheme": "divi",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.charlieduong.divi.receipts",
      "infoPlist": {
        "NSBonjourServices": [
          "_expo._tcp",
          "_expo._tcp"
        ],
        "NSLocalNetworkUsageDescription": "Allow Divi to discover and connect to the development server on your local network.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.charlieduong.divi.receipts",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Divi to choose a receipt from your photos.",
          "cameraPermission": "Allow Divi to photograph a receipt for bill splitting."
        }
      ],
      [
        "expo-ocr-kit",
        {
          "cameraPermission": "Allow Divi to photograph a receipt for bill splitting."
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "1ed760b1-3802-4924-8f15-54427c488ccb"
      }
    }
  }
}
